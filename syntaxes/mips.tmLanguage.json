{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "MIPS",
  "scopeName": "source.mips",
  "patterns": [
    {
      "name": "comment.line.number-sign.mips",
      "begin": "#",
      "end": "$"
    },
    {
      "name": "string.quoted.double.mips",
      "begin": "\"",
      "end": "\"",
      "patterns": [{ "name": "constant.character.escape.mips", "match": "\\\\." }]
    },
    {
      "name": "string.quoted.single.mips",
      "begin": "'",
      "end": "'",
      "patterns": [{ "name": "constant.character.escape.mips", "match": "\\\\." }]
    },
    {
      "match": "^[ \\t]*(?:([A-Za-z_.$][A-Za-z0-9_.$]*)(:)[ \\t]*([A-Za-z][A-Za-z0-9_.]*)?|([A-Za-z][A-Za-z0-9_.]*))",
      "captures": {
        "1": { "name": "entity.name.label.mips" },
        "2": { "name": "punctuation.definition.label.mips" },
        "3": { "name": "keyword.control.instruction.mips" },
        "4": { "name": "keyword.control.instruction.mips" }
      }
    },
    {
      "name": "storage.modifier.directive.mips",
      "match": "(?<![A-Za-z0-9_.$])\\.[A-Za-z_][A-Za-z0-9_]*"
    },
    {
      "name": "variable.language.register.mips",
      "match": "\\$(?:[A-Za-z][A-Za-z0-9]*|[0-9]+)\\b"
    },
    {
      "name": "constant.numeric.mips",
      "match": "(?<![A-Za-z0-9_.$])[-+]?(?:0[xX][0-9A-Fa-f]+|0[bB][01]+|[0-9]+(?:\\.[0-9]+)?(?:[eE][-+]?[0-9]+)?)(?![A-Za-z0-9_.$])"
    }
  ]
}

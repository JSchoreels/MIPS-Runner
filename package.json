{
  "name": "mips-runner",
  "displayName": "MIPS Runner",
  "description": "Run and inspect MIPS assembly with the SPIM simulator inside VS Code.",
  "version": "0.0.10",
  "publisher": "Jisko",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/JSchoreels/MIPS-Runner.git"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": ["Debuggers", "Programming Languages"],
  "main": "./src/extension.js",
  "activationEvents": [
    "onLanguage:mips",
    "onCommand:mipsRunner.loadActiveFile",
    "onView:mipsRunner.simulator",
    "onDebugInitialConfigurations",
    "onDebugResolve:mips-runner"
  ],
  "contributes": {
    "breakpoints": [{ "language": "mips" }],
    "debuggers": [
      {
        "type": "mips-runner",
        "label": "MIPS Runner",
        "languages": ["mips"],
        "configurationAttributes": {
          "launch": {
            "required": ["program"],
            "properties": {
              "program": { "type": "string", "default": "${file}", "description": "MIPS source file to debug." },
              "stopOnEntry": { "type": "boolean", "default": false, "description": "Pause at the first instruction." }
            }
          }
        },
        "initialConfigurations": [
          { "type": "mips-runner", "request": "launch", "name": "Debug MIPS", "program": "${file}" }
        ]
      }
    ],
    "configuration": {
      "title": "MIPS Runner",
      "properties": {
        "mipsRunner.openBehavior": {
          "type": "string",
          "scope": "resource",
          "default": "ask",
          "enum": ["ask", "auto", "manual"],
          "enumDescriptions": [
            "Ask whether to load an active MIPS file.",
            "Automatically load the active MIPS file.",
            "Only load files using the MIPS Runner command."
          ],
          "description": "Choose what MIPS Runner does when a MIPS file becomes active."
        }
      }
    },
    "languages": [
      {
        "id": "mips",
        "aliases": ["MIPS", "mips"],
        "extensions": [".s", ".asm", ".mips"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "mips",
        "scopeName": "source.mips",
        "path": "./syntaxes/mips.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "mipsRunner.loadActiveFile",
        "title": "MIPS Runner: Load Active File",
        "icon": "$(play)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "mipsRunner.loadActiveFile",
          "when": "resourceExtname == .s || resourceExtname == .asm || resourceExtname == .mips",
          "group": "navigation"
        }
      ]
    },
    "viewsContainers": {
      "panel": [
        {
          "id": "mipsRunner",
          "title": "MIPS Runner",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "mipsRunner": [
        {
          "id": "mipsRunner.simulator",
          "type": "webview",
          "name": "Simulator",
          "contextualTitle": "MIPS Runner",
          "icon": "media/icon.svg"
        }
      ]
    }
  },
  "scripts": {
    "check:extension": "node --check src/extension.js",
    "check:runner": "node --check media/runner.js",
    "check:worker": "node --check src/simulator-worker.js",
    "check:symbol-source": "node --check src/source-symbols.js",
    "check:symbol-worker": "node --check src/symbol-worker.js",
    "check:registers": "node --check src/registers.js",
    "check:debug": "node --check src/debug-adapter.js"
  }
}
